# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing and verifying authentication tokens on production (e.g. Vercel)
# If not set, a built-in secure fallback key is used automatically.
SESSION_SECRET="fawnic_atelier_auth_secret_key_2026"

# ==============================================================================
# PRODUCTION PERSISTENT DATABASE STORAGE (FOR VERCEL SERVERLESS)
# ==============================================================================
# In local development and AI Studio, data is automatically saved to data/fawnic_db.json.
# On Vercel Serverless (which is stateless across Lambdas), configure any ONE of the
# following cloud storage options to persist all Admin ↔ Customer data across all instances:
#
# Option A: Vercel KV / Upstash Redis (Recommended — 1-Click in Vercel Storage)
# KV_REST_API_URL="https://your-upstash-instance.upstash.io"
# KV_REST_API_TOKEN="AX..."
# UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AX..."
#
# Option B: JSONBin.io (Instant Cloud JSON Storage)
# JSONBIN_BIN_ID="your_bin_id"
# JSONBIN_API_KEY="$2a$10$..."
#
# Option C: Supabase
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1..."
#
# Option D: Custom Remote Storage Endpoint
# STORAGE_API_URL="https://your-api.com/database"
# STORAGE_API_KEY="your_api_key"
