# Private Key (secret) from ImageKit dashboard (Developer options)
IMAGEKIT_PRIVATE_KEY=""

# URL-endpoint from ImageKit dashboard (e.g. https://ik.imagekit.io/your_id)
IMAGEKIT_URL_ENDPOINT=""

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key for signing and verifying user and admin session tokens
SESSION_SECRET=""

# ------------------------------------------------------------------------------
# 4. TRANSACTIONAL EMAIL PROVIDER (Password Reset OTP Delivery)
# ------------------------------------------------------------------------------
# Sender display address (e.g. 'FAWNIC Atelier <support@fawnic.pk>')
EMAIL_FROM=""

# Option A: RESEND (Modern HTTPS REST API — Recommended for Vercel Serverless)
# Get key from https://resend.com/api-keys
RESEND_API_KEY=""
RESEND_FROM=""

# Option B: STANDARD SMTP (Gmail, Hostinger, AWS SES, Namecheap, cPanel, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Set to 'true' for port 465 (SSL), or 'false' for port 587 (TLS/STARTTLS)
SMTP_SECURE="false"
SMTP_FROM=""

# Option C: SENDGRID (REST API)
SENDGRID_API_KEY=""
SENDGRID_FROM=""

# Option D: BREVO (REST API)
BREVO_API_KEY=""
BREVO_FROM=""

# Option E: POSTMARK (REST API)
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM=""

# ------------------------------------------------------------------------------
# 5. APPLICATION & HOSTING CONFIGURATION
# ------------------------------------------------------------------------------
# Hosted application URL (e.g. https://fawnic.vercel.app or custom domain)
APP_URL=""

# Port for local server (default: 3000)
PORT="3000"

# Optional Gemini API Key (if AI Studio features are used)
GEMINI_API_KEY=""
