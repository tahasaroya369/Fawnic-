# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL (Production Database)
# Project Name: fawnic
# ------------------------------------------------------------------------------
# Direct or pooled PostgreSQL connection string from your Neon dashboard
# Example format: postgresql://[user]:[password]@[endpoint].neon.tech/fawnic?sslmode=require
DATABASE_URL=""
# Alternative alias if provided by Vercel Neon integration:
